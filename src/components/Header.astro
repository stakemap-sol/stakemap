---
import { SITE } from '../lib/site';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" id="brand-home" aria-label={`${SITE.name} - ${SITE.tagline}`}>
      <img src="/brand/stakemap-avatar-96.png?v=2" alt="" class="brand-mark" width="40" height="40" />
      <span class="brand-text">
        <span class="brand-name"><span class="brand-stake">Stake</span><span class="brand-map">Map</span></span>
        <span class="brand-tagline">{SITE.tagline}</span>
      </span>
    </a>

    <div class="header-actions">
      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Switch between light and dark theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a
        href={SITE.builder.url}
        class="by-pill"
        target="_blank"
        rel="noopener"
        aria-label={`Built and run by ${SITE.builder.name}`}
      >
        <img src={SITE.builder.avatar} alt="" class="by-pill-logo" width="20" height="20" />
        <span class="by-pill-text">by {SITE.builder.name}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    color: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  .header-inner {
    max-width: 1180px;
    margin-inline: auto;
    padding: 11px 24px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: white;
    text-decoration: none;
    flex-shrink: 1;
    min-width: 0;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }
  .brand-name {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }
  .brand-stake {
    color: var(--brand-mint);
  }
  .brand-map {
    color: var(--brand-yellow);
  }
  .brand-tagline {
    font-size: 12.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .by-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: background-color 0.15s ease;
    white-space: nowrap;
  }
  .by-pill:hover {
    background: rgba(255, 255, 255, 0.2);
    text-decoration: none;
    color: white;
  }
  .by-pill-logo {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .theme-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.18);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background-color 0.15s ease;
  }
  .theme-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  /* Theme icon swap: sun in light, moon in dark. */
  .theme-btn .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-btn .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-btn .icon-moon {
    display: block;
  }

  @media (max-width: 720px) {
    .brand-tagline {
      display: none;
    }
    .brand-name {
      font-size: 19px;
    }
  }
  @media (max-width: 520px) {
    /* On phones the pill is the builder's logo alone. */
    .by-pill {
      width: 36px;
      height: 36px;
      padding: 0;
      justify-content: center;
    }
    .by-pill-text {
      display: none;
    }
    .by-pill-logo {
      width: 26px;
      height: 26px;
    }
  }
  @media (max-width: 480px) {
    .header-inner {
      padding: 10px 16px;
      gap: 12px;
    }
    .header-actions {
      gap: 8px;
    }
  }
</style>

<script>
  // Theme toggle. The dashboard watches data-theme on <html> and follows.
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') || 'light';
    const next = current === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    try {
      localStorage.setItem('siteTheme', next);
    } catch (_) {
      /* ignore quota errors */
    }
  });

  // The brand opens the main view of the dashboard without reloading the
  // page (and its data). A modified click keeps the normal link behaviour.
  const brandHome = document.getElementById('brand-home');
  brandHome?.addEventListener('click', (e) => {
    const crumbHome = document.getElementById('breadcrumb-home');
    if (!crumbHome || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    e.preventDefault();
    crumbHome.click();
    window.scrollTo({ top: 0 });
  });
</script>
