---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
---

<Layout title={`Page not found - ${SITE.name}`} noindex>
  <section class="nf">
    <img src="/brand/decor/signpost-tile.webp" alt="" width="150" height="123" class="nf-mark" />
    <h1>404</h1>
    <p>This page is not on the map.</p>
    <a href="/" class="nf-link">Open {SITE.name}</a>
  </section>
</Layout>

<style>
  .nf {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 64px 24px;
    text-align: center;
  }
  .nf-mark {
    width: 150px;
    height: 123px;
  }
  h1 {
    margin: 8px 0 0;
    font-size: 56px;
    line-height: 1;
    color: var(--color-primary-dark);
  }
  p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .nf-link {
    margin-top: 12px;
    padding: 10px 22px;
    border-radius: 999px;
    background: var(--brand-teal);
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }
  .nf-link:hover {
    background: var(--brand-teal-2);
  }
</style>
